# The Firebase web config for the visit counter, as one line of JSON. Copy this
# file to .env to count visits from a local build; the deploy takes the same
# value from the FIREBASE_CONFIG repository variable.
#
# None of it is secret — a web config ships inside every page that uses it, and
# what may be written with it is decided by firestore.rules. Leave it unset and
# the page counts nothing and loads no Firebase at all.
VITE_FIREBASE={"apiKey":"...","projectId":"...","appId":"..."}
